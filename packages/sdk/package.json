{
  "name": "@layr-labs/ecloud-sdk",
  "version": "0.0.0-development",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "tools",
    "VERSION",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./compute": {
      "types": "./dist/compute.d.ts",
      "import": "./dist/compute.js",
      "require": "./dist/compute.cjs"
    },
    "./billing": {
      "types": "./dist/billing.d.ts",
      "import": "./dist/billing.js",
      "require": "./dist/billing.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./attest": {
      "types": "./dist/attest.d.ts",
      "import": "./dist/attest.js",
      "require": "./dist/attest.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:dev": "BUILD_TYPE=dev tsup",
    "prepublishOnly": "cp ../../README.md .",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "7.10.1",
    "@napi-rs/keyring": "1.2.0",
    "axios": "1.15.0",
    "chalk": "5.6.2",
    "dockerode": "4.0.9",
    "form-data": "4.0.5",
    "handlebars": "4.7.9",
    "jose": "6.1.3",
    "js-yaml": "4.1.1",
    "node-forge": "1.4.0",
    "posthog-node": "5.20.0",
    "siwe": "2.3.2",
    "viem": "2.43.5"
  },
  "devDependencies": {
    "@types/dockerode": "3.3.47",
    "@types/form-data": "2.5.2",
    "@types/js-yaml": "4.0.9",
    "@types/node-forge": "1.3.14",
    "@types/react": "18.3.27"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
