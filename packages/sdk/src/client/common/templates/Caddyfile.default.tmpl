# Caddy configuration for automatic HTTPS
#
# Two sites can be configured at runtime via env vars that
# ecloud-platform / the CLI inject into tee-env metadata:
#
#   ECLOUD_PLATFORM_HOST — the platform-derived hostname
#                          (<addr>.<env>.eigencloud.xyz). Always set
#                          for platform-routed apps. Cert at
#                          /run/tls/platform/fullchain.pem.
#   DOMAIN               — optional user-supplied custom domain.
#                          Cert at /run/tls/domain/fullchain.pem.
#
# When a variable is unset, Caddy substitutes the default listed
# after the colon. We use distinct defaults per site so each block
# binds to a unique name at bootstrap — both blocks overlapping
# on "localhost" would cause Caddy to reject the config.
{$ECLOUD_PLATFORM_HOST:localhost.platform.invalid} {
    tls /run/tls/platform/fullchain.pem /run/tls/platform/privkey.pem

    reverse_proxy localhost:{$APP_PORT:3000} {
        health_uri /health
        health_interval 30s
        health_timeout 5s
        health_status 200
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }

    request_body {
        max_size 10MB
    }
}

{$DOMAIN:localhost.user.invalid} {
    tls /run/tls/domain/fullchain.pem /run/tls/domain/privkey.pem

    reverse_proxy localhost:{$APP_PORT:3000} {
        health_uri /health
        health_interval 30s
        health_timeout 5s
        health_status 200
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }

    request_body {
        max_size 10MB
    }
}

# HTTP endpoint (optional, for health checks or redirects)
:80 {
    # Redirect to HTTPS for any real (non-placeholder) host
    @for_domain expression {host} != "localhost.platform.invalid" && {host} != "localhost.user.invalid" && {host} != "localhost"
    redir @for_domain https://{host}{uri} permanent

    # Health check endpoint (always available via HTTP)
    handle /health {
        respond "OK" 200
    }
}
