{
  "name": "@layr-labs/ecloud-cli",
  "version": "0.0.0-development",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "VERSION",
    "README.md"
  ],
  "bin": {
    "ecloud": "./bin/run.js",
    "ecloud-dev": "./bin/run.js"
  },
  "dependencies": {
    "@inquirer/prompts": "7.10.1",
    "@layr-labs/ecloud-sdk": "workspace:*",
    "@napi-rs/keyring": "1.2.0",
    "@oclif/core": "4.8.0",
    "@oclif/plugin-autocomplete": "3.2.40",
    "axios": "1.15.2",
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "dockerode": "4.0.9",
    "form-data": "4.0.5",
    "handlebars": "4.7.9",
    "jose": "6.1.3",
    "js-yaml": "4.1.1",
    "node-forge": "1.4.0",
    "open": "11.0.0",
    "viem": "2.43.5"
  },
  "scripts": {
    "build": "tsup",
    "build:dev": "BUILD_TYPE=dev tsup",
    "prepublishOnly": "cp ../../README.md .",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ecloud": "node bin/run.js"
  },
  "oclif": {
    "bin": "ecloud",
    "commands": "./dist/commands",
    "dirname": "",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-autocomplete"
    ],
    "hooks": {
      "init": "./dist/hooks/init/version-check"
    },
    "topics": {
      "auth": {
        "description": "Manage authentication with private keys stored in OS keyring"
      },
      "billing": {
        "description": "Manage billing and subscriptions"
      },
      "compute": {
        "description": "Manage compute projects and resources"
      },
      "compute:app": {
        "description": "Manage projects"
      },
      "compute:app:profile": {
        "description": "Manage app profiles"
      },
      "compute:app:configure": {
        "description": "Configure app settings"
      },
      "compute:environment": {
        "description": "Manage deployment environment [alias: env]"
      },
      "compute:build": {
        "description": "Verifiable builds (build from git source + provenance verification)"
      },
      "compute:env": {
        "hidden": true,
        "description": "Manage deployment environment [alias: env]"
      },
      "admin": {
        "description": "Admin operations (requires admin privileges)"
      },
      "admin:coupons": {
        "description": "Manage coupons"
      },
      "admin:admins": {
        "description": "Manage admin users"
      }
    }
  },
  "devDependencies": {
    "@types/form-data": "2.5.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "18.19.130",
    "ts-node": "10.9.2"
  }
}
