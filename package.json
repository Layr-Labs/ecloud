    "@typescript-eslint/parser": "8.52.0",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "prettier": "3.7.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "vite": "7.3.2",
    "vitest": "4.1.4"
  },
  "prettier": {
    "printWidth": 100
  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "3.1.5",
